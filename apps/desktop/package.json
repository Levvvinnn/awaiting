{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run && node scripts/run-electron-node.mjs scripts/smoke-sqlite.mjs",
    "smoke:sqlite": "node scripts/run-electron-node.mjs scripts/smoke-sqlite.mjs",
    "smoke:app": "electron-vite build && node scripts/run-app-smoke.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@awaiting/core": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.11.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
