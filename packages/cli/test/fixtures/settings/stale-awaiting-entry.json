          { "type": "command", "command": "node \"C:/Users/old/.awaiting/hook/Awaiting-Hook.js\"" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["/old/repo/hooks/awaiting-hook.js"] }
        ]
      }
    ]
  }
}
